---
import Layout from '../../layouts/Layout.astro';
import Story from '../../components/Story.astro';
import e from '../../data/edition.json';
import {link,date,pct,score,spark,gateLabels} from '../../components/format';
export function getStaticPaths() {return e.dossiers.map((d:any)=>({params:{slug:d.slug},props:{dossier:d}}));}
const {dossier:d} = Astro.props;
const i:any = e.instruments.find((i:any)=>i.id===d.slug);
const stories = e.editorial.stories.filter((s:any)=>s.holding_id===d.slug);
const gates = Object.entries(i?.momentum?.gates || {});
---
<Layout title={`${d.name} · Own the Machine`} active="dossiers"><div class="wrap"><header class="page-head"><a class="text-link" href={link('dossiers/')}>← The collection</a><div class="eyebrow" style="margin-top:30px">{d.symbol} / {i?.exchange} / {i?.currency}</div><h1>{d.name}</h1></header><div class="article-layout"><article><p class="article-copy">{d.what_it_is}</p><h2>Inside the system.</h2><ol class="system-list">{d.systems.map((system:string,index:number)=><li><span>{String(index+1).padStart(2,'0')}</span>{system}</li>)}</ol><h2>What to watch.</h2><p>{d.watch}</p><h2>Against the thesis.</h2><p>{d.against}</p><a class="text-link" href={d.official_source} target="_blank" rel="noopener noreferrer">Explore the primary source ↗</a>{['ge-aerospace','vall'].includes(d.slug) && <div class="notice">{d.comparability_note}</div>}<section class="small-section"><div class="eyebrow">This week / {date(e.issue_date)}</div>{stories.length ? stories.map((s:any,n:number)=><Story story={s} index={n}/>) : <p>No clipping for this instrument was selected in the current edition. Check the source record for collection coverage.</p>}</section></article><aside class="article-aside"><div class="eyebrow">The price record</div><div style="font-family:var(--display);font-size:90px;line-height:1.2">{score(i?.momentum?.portfolio_momentum_score)}<span style="font-family:var(--body);font-size:13px;color:var(--muted)"> / 100</span></div><p class="fineprint" style="margin-top:0">Portfolio momentum · {i?.metrics.latest_date || 'No current data'}</p><svg viewBox="0 0 140 44" width="100%" height="100" role="img" aria-label="Recent adjusted price closes" style="margin-block:25px;color:var(--muted)"><polyline points={spark(i?.market?.close_tail)} fill="none" stroke="currentColor" stroke-width=".8" /></svg>{['1D','1W','1M','YTD','1Y','5Y'].map(p=><div class="stat-row"><span>{p}</span><strong>{pct(i?.metrics.periods[p]?.return)}</strong></div>)}<p class="fineprint">{i?.return_basis === 'adjusted_close' ? 'Provider-adjusted close history.' : 'Adjustment could not be verified.'} Currency: {i?.currency}. These figures exclude your position size and purchase price.</p><div class="eyebrow" style="margin-top:35px">Stage 2 / {i?.momentum?.gates_passed ?? '—'} of 8 gates</div>{gates.map(([name,passed])=><div class="stat-row"><span>{gateLabels[name] || name.replaceAll('_',' ')}</span><strong>{passed?'Pass':'Not met'}</strong></div>)}{!gates.length && <p class="fineprint">Insufficient validated history for the trend conditions.</p>}<a class="text-link" style="margin-top:25px" href={link('receipts/')}>Sources & definitions →</a></aside></div></div></Layout>
