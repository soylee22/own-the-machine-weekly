---
import Story from './Story.astro';
import {link, date, pct, score, spark} from './format';
const {edition: e, archived = false} = Astro.props;
const stories = e.editorial?.stories || [];
const instruments = e.instruments || [];
const dossiers = e.dossiers || [];
const issueNumber = Math.max(1, Math.floor((Date.parse(e.issue_date) - Date.parse('2026-09-20')) / 604800000) + 1);
const machine = dossiers.find((d: any) => d.slug === e.editorial?.machine_of_week?.holding_id) || dossiers[(issueNumber - 1) % dossiers.length];
const machineInstrument = instruments.find((x: any) => x.id === machine?.slug);
const counterpoint = e.editorial?.against_the_thesis;
const coverFeature = e.editorial?.feature?.status === 'ready' ? e.editorial.feature : null;
const sectors = [
  {name:'Aerospace & defence', ids:['bae-systems','ge-aerospace','lockheed-martin','rheinmetall','rolls-royce'], number:'01'},
  {name:'The financial system', ids:['jpmorgan','goldman-sachs','hsbc','mufg','morgan-stanley'], number:'02'},
  {name:'Energy & resources', ids:['bp','chevron','exxonmobil','shell'], number:'03'},
  {name:'The wider world', ids:['cnx1','vall','sgln-gold'], number:'04'},
];
---
<section class="cover wrap">
  <div class="issue-line"><span>{archived ? 'From the archive' : 'The Sunday edition'}</span><time datetime={e.issue_date}>{date(e.issue_date)}</time><span>No. {String(issueNumber).padStart(3,'0')}</span></div>
  <h1 class="cover-title">OWN THE<br /><span>MACHINE.</span></h1>
  <div class="cover-deck"><p>Behind every ticker,<br /><em>something real.</em></p><div><p>{coverFeature ? <>{coverFeature.holding_name}.<br />{coverFeature.operation_label || 'Something moved this week.'}</> : <>Engines. Shipyards. Energy networks.<br />The financial systems that connect them.</>}</p><a class="accent-link" href="#the-week">Read this edition <span>↓</span></a></div></div>
  <figure class="cover-image"><img src={link(e.image.path)} alt={e.image.alt} width="1600" height="1370" fetchpriority="high" /><div class="image-overlay"><span>Field study / propulsion</span><strong>Built to work.<br />Made to endure.</strong></div><figcaption><span>{e.image.caption}</span><span>Image: {e.image.credit} · Technical archive, not this week’s event</span></figcaption></figure>
  <div class="edition-facts"><span><b>{instruments.length}</b> instruments followed</span><span><b>{stories.length}</b> selected clippings</span><span><b>{e.quality?.ready_market_count || 0}</b> current price series</span><a href={link('receipts/')}>Inspect the evidence ↗</a></div>
</section>
<section class="section wrap" id="the-week">
  {archived && <div class="notice">This is a preserved edition. <a href={link(`archive/${e.issue_date}/data.json`)}>Download its complete data snapshot ↗</a>. Dossier links open the current company reference pages.</div>}
  {e.status === 'partial' && <div class="notice">Some market data was unavailable. This edition contains {e.quality.ready_market_count} current series out of {instruments.length}. <a href={link('receipts/')}>See the collection record →</a></div>}
  <div class="section-heading"><div class="eyebrow">01 / The week in the machine</div><h2>The world<br /><em>keeps building.</em></h2><p>Concrete developments from the companies in this edition. Open each clipping for the original report.</p></div>
  {stories.length ? <div class="story-list">{stories.map((story: any, i: number) => <Story story={story} index={i} />)}</div> : <div class="empty"><h3>A quieter edition.</h3><p>No operational story met the selection rules for this week. The machine dossiers and market data are still here to explore.</p><a href={link('receipts/')}>See collection status →</a></div>}
  <p class="fineprint">Publication dates fall within this issue’s seven-day window. Price changes are context, not proof of a news catalyst.</p>
</section>
{machine && <section class="machine-feature">
  <div class="wrap machine-grid"><div class="feature-aside"><div class="eyebrow">02 / One machine, properly considered</div><div class="machine-index">{String(issueNumber).padStart(2,'0')}</div><span class="mono">{machine.symbol} / Field notes</span></div><div><h2>{machine.name}</h2><p class="feature-copy">{machine.what_it_is}</p><div class="system-chain">{machine.systems.map((system: string, i: number) => <div><span>{String(i + 1).padStart(2,'0')}</span><strong>{system}</strong></div>)}</div><div class="feature-bottom"><a class="light-link" href={link(`dossiers/${machine.slug}/`)}>Explore the dossier →</a><span class="mono">1W {pct(machineInstrument?.metrics?.periods?.['1W']?.return)}</span></div></div></div>
</section>}
<section class="section wrap">
  <div class="section-top"><div><div class="eyebrow">03 / The tape</div><h2>Motion,<br /><em>in perspective.</em></h2></div><a class="text-link" href={link('data/')}>{archived ? 'Current data & momentum →' : 'All periods & momentum →'}</a></div>
  <div class="tape-grid">{sectors.map(sector => <div class="tape-sector"><h3><span>{sector.number}</span>{sector.name}</h3>{instruments.filter((i: any) => sector.ids.includes(i.id)).map((item: any) => <a class="tape-row" href={link(`dossiers/${item.id}/`)}><div><strong>{item.name}</strong><span>{item.symbol}</span></div><svg viewBox="0 0 140 44" aria-label={`${item.name} recent adjusted closes`} role="img"><polyline points={spark(item.market?.close_tail)} fill="none" stroke="currentColor" stroke-width="2" /></svg><div class="tape-return"><strong>{pct(item.metrics?.periods?.['1W']?.return)}</strong><span>1 week</span></div></a>)}</div>)}</div>
  <p class="fineprint">Each return uses the instrument’s quote currency. These are security returns, not personal portfolio returns. Missing history is shown as a dash.</p>
</section>
{machine && <section class="section wrap counterpoint"><div><div class="eyebrow">04 / Against the thesis</div><h2>Admire the machine.<br /><em>Question the business.</em></h2></div><div><span class="mono">{machine.name}</span>{counterpoint?.status === 'ready' ? <><p>{counterpoint.title}</p><div class="story-receipt"><span>{counterpoint.source_name}</span><time datetime={counterpoint.published_date}>{counterpoint.published_date}</time></div><p class="fineprint">{counterpoint.note}</p><a class="text-link" href={counterpoint.source_url} target="_blank" rel="noopener noreferrer">Read the current counterpoint ↗</a></> : <><p>{machine.against}</p><p class="fineprint">No qualifying current counterpoint crossed the evidence threshold this week, so this is the standing dossier challenge.</p><a class="text-link" href={machine.official_source} target="_blank" rel="noopener noreferrer">Read the company’s own account ↗</a></>}</div></section>}
<section class="section wrap explorer"><div><div class="eyebrow">The collection</div><h2>Follow your<br /><em>curiosity.</em></h2><p>{instruments.length} instruments. Different machines, different economics. Open a dossier and look closer.</p></div><div class="explore-actions"><button class="surprise-button" data-dossiers={JSON.stringify(dossiers.map((d: any) => link(`dossiers/${d.slug}/`)))}>Surprise me <span>↗</span></button><a class="text-link" href={link('dossiers/')}>Browse every machine →</a></div></section>
<script>
  document.querySelectorAll<HTMLButtonElement>('.surprise-button').forEach(button => button.addEventListener('click', () => {
    const urls = JSON.parse(button.dataset.dossiers || '[]');
    if (urls.length) window.location.href = urls[Math.floor(Math.random() * urls.length)];
  }));
</script>
